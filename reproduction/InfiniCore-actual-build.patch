+            impl_->copy_from(source_tensor);
+        }
+    } else {
+        if (num_shards_ == 0) {
+            throw std::runtime_error("num_shards_ is 0 but entered new logic branch!");
+        }
+
+        Size replica_size = tp_size_ / num_shards_;
+        if (replica_size == 0) {
