+#pragma once
+
+#include "../../common/LRUCache.hpp"
+#include "../../context/context.hpp"
+#include <array>
+#include <functional>
+#include <memory>
+#include <vector>
+
+namespace infinicore::op::common {
+
+template <typename Key, typename Value>
+class OpCache {
+private:
+    using BaseCache = infinicore::common::LRUCache<Key, Value>;
+    using Destructor = typename BaseCache::Destructor;
+    using CacheVector = std::vector<BaseCache>;
+
+public:
+    explicit OpCache(size_t capacity = 100, Destructor destructor = nullptr)
+        : capacity_(capacity), destructor_(destructor) {}
+
+    ~OpCache() {
+        clear();
+    }
+
+    BaseCache &getCache(Device::Type device_type, size_t device_index) {
+        auto &cache_vector = caches_[static_cast<size_t>(device_type)];
+
+        if (cache_vector.size() <= device_index) {
+            cache_vector.resize(device_index + 1, BaseCache(capacity_, destructor_));
+        } else {
+            cache_vector[device_index].setDestructor(destructor_);
+        }
+
+        return cache_vector[device_index];
+    }
+
+    BaseCache &getCache(Device device) {
+        return getCache(device.getType(), device.getIndex());
+    }
+
+    void setCapacity(size_t capacity) {
+        capacity_ = capacity;
+        for (auto &vec : caches_) {
+            for (auto &cache : vec) {
+                cache.setCapacity(capacity);
+            }
+        }
+    }
+
+    void clear() {
+        bool populated = false;
+        for (const auto &vec : caches_) {
+            for (const auto &cache : vec) {
+                populated = populated || !cache.getAllItems().empty();
+            }
+        }
+        if (!populated) {
+            caches_ = {};
+            return;
+        }
+
+        // Thread-local descriptors can outlive ContextImpl during process exit.
+        // Their cleanup needs a device, not an allocated Core runtime/stream.
+        // Use InfiniRT directly and restore its state; never revive ContextImpl.
+        auto check = [](infiniStatus_t status) {
+            if (status != INFINI_STATUS_SUCCESS) {
+                throw std::runtime_error("InfiniRT device selection failed during operator cache cleanup");
+            }
+        };
+        infiniDevice_t current_type;
+        int current_index;
+        check(infinirtGetDevice(&current_type, &current_index));
+        for (size_t type_idx = 0; type_idx < caches_.size(); ++type_idx) {
+            auto &vec = caches_[type_idx];
+            for (size_t dev_idx = 0; dev_idx < vec.size(); ++dev_idx) {
+                if (vec[dev_idx].getAllItems().empty()) continue;
+                auto type = static_cast<infiniDevice_t>(type_idx);
+                bool switched = type != current_type || static_cast<int>(dev_idx) != current_index;
+                if (switched) check(infinirtSetDevice(type, static_cast<int>(dev_idx)));
+                vec[dev_idx].clear();
+                if (switched) check(infinirtSetDevice(current_type, current_index));
+            }
+            vec.clear();
+        }
+        caches_ = {};
+    }
+
+private:
+    size_t capacity_;
+    Destructor destructor_;
+
+    std::array<CacheVector, static_cast<size_t>(Device::Type::COUNT)> caches_ = {};
+};
+
