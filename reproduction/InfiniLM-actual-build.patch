-infinicore::Tensor MiniMaxH3TransformerBlock::forward(
-    const infinicore::Tensor &hidden_states, const infinicore::Tensor &temb,
-    const infinicore::Tensor &adaln_indices,
-    const std::shared_ptr<infinicore::nn::RoPE> &rope,
