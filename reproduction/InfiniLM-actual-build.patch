@@ -0,0 +1,59 @@
+#pragma once
+// Host dispatch only. Device numerical code is generated by NineToothed.
+#include <infinicore/context/context.hpp>
+#include <infinicore/tensor.hpp>
+#include <atomic>
+#include <functional>
+#include <mutex>
+#include <shared_mutex>
+#include <stdexcept>
+
+namespace infinilm::h3_nine {
+using Tensor = infinicore::Tensor;
+using Callback = std::function<void(const char *, const Tensor &, const Tensor &,
+                                    const Tensor &, const Tensor &, uintptr_t)>;
+inline std::shared_mutex callback_mutex;
+inline Callback callback;
+inline bool pointwise_enabled = true, attention_enabled = true;
+inline std::atomic<uint64_t> adaln_calls{0}, residual_calls{0}, attention_calls{0};
+
+inline void set_callback(Callback next, bool pointwise = true, bool attention = true) {
+    // Reject replacement during forward instead of waiting while holding the GIL.
+    std::unique_lock lock(callback_mutex, std::try_to_lock);
+    if (!lock.owns_lock()) throw std::runtime_error("H3 forward active: cannot replace callback");
+    if (callback && next) throw std::runtime_error("An H3 Nine runtime is already installed");
+    callback = std::move(next);
+    pointwise_enabled = pointwise;
+    attention_enabled = attention;
+}
+
+inline bool try_compute(const char *op, const Tensor &x, const Tensor &a,
+                        const Tensor &b, Tensor &out) {
+    const bool is_attention = op[0] == 'a' && op[1] == 't';
+    auto device = x->device().getType();
+    // Measured native dispatch has a fixed host cost. Keep small H3 tensors
+    // on the original Core operators instead of paying for a slower fusion.
+    if (!is_attention && device == infinicore::Device::Type::HYGON) {
+        const size_t minimum = (op[0] == 'r' ? 1024 : 512) * size_t(5376);
+        if (x->ndim() != 3 || x->size(1) * x->size(2) < minimum) return false;
+    }
+    std::shared_lock lock(callback_mutex);
+    if (!callback || x->shape() != a->shape() || x->shape() != b->shape() ||
+        x->device() != a->device() || x->device() != b->device() ||
+        x->dtype() != a->dtype() || x->dtype() != b->dtype() ||
+        (x->dtype() != infinicore::DataType::F16 && x->dtype() != infinicore::DataType::BF16)) return false;
+    if (is_attention) {
+        if (!attention_enabled || x->ndim() != 4 || x->size(0) != 1 || x->size(1) < 1 ||
+            x->size(2) < 1 || (x->size(3) != 32 && x->size(3) != 64 && x->size(3) != 72 && x->size(3) != 128)) return false;
+    } else if (!pointwise_enabled || x->ndim() != 3 || x->size(0) != 1 || x->size(1) < 128 || x->size(2) < 64) return false;
+    if (device != infinicore::Device::Type::NVIDIA && device != infinicore::Device::Type::HYGON) return false;
+    if (infinicore::context::getDevice() != x->device())
+        throw std::runtime_error("H3 Nine input device differs from the native worker context");
+    if (infinicore::context::isGraphRecording()) throw std::runtime_error("H3 Nine bridge does not support graph capture");
+    out = Tensor::empty(x->shape(), x->dtype(), x->device());
+    callback(op, x, a, b, out, reinterpret_cast<uintptr_t>(infinicore::context::getStream()));
+    if (is_attention) ++attention_calls;
+    else if (op[0] == 'a') ++adaln_calls; else ++residual_calls;
+    return true;
+}
+} // namespace infinilm::h3_nine
